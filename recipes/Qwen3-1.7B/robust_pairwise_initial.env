# Initial experiment on Qwen3-1.7B / QRM-Llama3.1-8B-v2 / UltraChat.
# Source this file before `python scripts/grpo.py train` (or smoke --dry-run).
# Reward weight: 1.0. Thresholds use the raw weighted reward scale.
# Selected from the completed 800-step historical run: roughly the lowest
# 20% of pair gaps abstain; the highest 10% saturate at delta + c = 0.09.
# These are distribution-based starting values, not calibrated noise bounds.
# Evidence and alternatives: docs/EVALUATION_ZH.md.
export ADVANTAGE=robust_pairwise
export ADVANTAGE_KWARGS='{"delta":0.01,"c":0.08}'
